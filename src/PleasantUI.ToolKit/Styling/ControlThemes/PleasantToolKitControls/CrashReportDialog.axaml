<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PleasantUI.ToolKit.Controls"
                    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Width="640" Height="560" Background="#40000000">
            <controls:CrashReportDialog ApplicationName="MyApp"
                                        ApplicationVersion="1.0.0"
                                        ExceptionType="System.NullReferenceException"
                                        ExceptionMessage="Object reference not set to an instance of an object."
                                        ExceptionSource="MyApp.Core"
                                        StackTrace="   at MyApp.Core.Foo() in Foo.cs:line 42"
                                        OccurredAt="2025-04-09 14:32:01" />
        </Border>
    </Design.PreviewWith>

    <!-- ── CrashReportDialog ─────────────────────────────────────────────── -->
    <ControlTheme x:Key="{x:Type controls:CrashReportDialog}" TargetType="controls:CrashReportDialog">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="MinWidth" Value="560" />
        <Setter Property="MaxWidth" Value="680" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />

        <Setter Property="Template">
            <ControlTemplate>
                <ShadowBorder CornerRadius="{TemplateBinding CornerRadius}"
                              BlurRadius="50"
                              ShadowColor="#6E000000"
                              Offset="0 8">
                    <Border Background="{DynamicResource BackgroundColor1}"
                            BorderBrush="{DynamicResource ControlBorderColor}"
                            BorderThickness="{DynamicResource ControlBorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource BackgroundColor3}"
                                    Padding="20 16">
                                <Grid ColumnDefinitions="Auto,16,*">
                                    <!-- Warning icon badge -->
                                    <Border Grid.Column="0"
                                            Width="44" Height="44"
                                            CornerRadius="{DynamicResource RoundedControlCornerRadius}"
                                            Background="{DynamicResource SystemFillColorCritical}">
                                        <PathIcon Data="{StaticResource ErrorCircleRegular}"
                                                  Width="22" Height="22"
                                                  Foreground="{ForegroundBased SystemFillColorCritical}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Theme="{StaticResource SubtitleTextBlockTheme}"
                                               Text="{Localize ToolKit/CrashReportDialog/CrashHasOccurred, Default='A crash has occurred!'}" />
                                </Grid>
                            </Border>
                            
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource BackgroundColor2}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="12 6"
                                    Margin="5 5 5 0">
                                <ListBox Name="PART_TabStrip"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerTheme="{StaticResource HorizontalListBoxItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="15 7" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    
                                    <ListBoxItem Tag="general" Content="{Localize ToolKit/CrashReportDialog/General, Default='General'}" IsSelected="True" />
                                    <ListBoxItem Tag="exception" Content="{Localize ToolKit/CrashReportDialog/Exception, Default='Exception'}" />
                                    <ListBoxItem Tag="screenshot" Content="{Localize ToolKit/CrashReportDialog/Screenshot, Default='Screenshot'}">
                                        <ListBoxItem.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <TemplateBinding Property="ShowScreenshotTab" />
                                                <TemplateBinding Property="Screenshot" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                            </MultiBinding>
                                        </ListBoxItem.IsVisible>
                                    </ListBoxItem>
                                </ListBox>
                            </Border>
                            
                            <Border DockPanel.Dock="Bottom"
                                    Background="{DynamicResource BackgroundColor3}"
                                    Padding="16 12">
                                <Grid RowDefinitions="Auto,Auto">
                                    <!-- Status / progress row -->
                                    <Border Grid.Row="0"
                                            Name="PART_StatusRow"
                                            Background="{DynamicResource BackgroundColor2}"
                                            BorderBrush="{DynamicResource ControlBorderColor}"
                                            BorderThickness="{DynamicResource ControlBorderThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="10 7"
                                            Margin="0 0 0 10"
                                            IsVisible="False">
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                            <!-- Text and icons -->
                                            <StackPanel Grid.Row="0"
                                                        Orientation="Horizontal" Spacing="10"
                                                        HorizontalAlignment="Center">
                                                <PathIcon Name="PART_SuccessIcon"
                                                          Data="{StaticResource CheckmarkRegular}"
                                                          Width="16" Height="16"
                                                          Foreground="{DynamicResource SystemFillColorSuccess}"
                                                          IsVisible="False"
                                                          VerticalAlignment="Center" />
                                                <PathIcon Name="PART_FailureIcon"
                                                          Data="{StaticResource AlertOutline}"
                                                          Width="16" Height="16"
                                                          Foreground="{DynamicResource SystemFillColorCritical}"
                                                          IsVisible="False"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="{TemplateBinding StatusMessage}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColor1}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- Progress bar below -->
                                            <ProgressBar Name="PART_SendingProgress"
                                                         Grid.Row="1"
                                                         IsIndeterminate="True"
                                                         Height="12"
                                                         HorizontalAlignment="Stretch"
                                                         IsVisible="False" />
                                        </Grid>
                                    </Border>

                                    <!-- Action buttons -->
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,8,Auto,8,Auto">
                                        <!-- Save button (left) -->
                                        <Button Name="PART_SaveButton"
                                                Grid.Column="0"
                                                Padding="12 6"
                                                FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PleasantIcon Icon="{StaticResource DocumentRegular}" Width="12" Height="12" />
                                                <TextBlock Text="{Localize ToolKit/CrashReportDialog/SaveReport, Default='Save Report'}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Send button -->
                                        <Button Name="PART_SendButton"
                                                Grid.Column="2"
                                                Theme="{StaticResource AccentButtonTheme}"
                                                Padding="14 6"
                                                FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PleasantIcon Icon="{StaticResource ArrowRightRegular}" Width="12" Height="12" />
                                                <TextBlock Text="{Localize ToolKit/CrashReportDialog/SendReport, Default='Send Report'}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Cancel button -->
                                        <Button Name="PART_CancelButton"
                                                Grid.Column="4"
                                                Padding="12 6"
                                                FontSize="12">
                                            <ContentControl Content="{Localize Cancel, Default='Cancel'}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Panel ClipToBounds="True"
                                   MinHeight="260"
                                   MaxHeight="340">
                                <!-- General tab -->
                                <ScrollViewer Name="PART_GeneralTab"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsVisible="False">
                                    <StackPanel Spacing="12" Margin="20 16">
                                        <!-- App info row -->
                                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto"
                                              RowSpacing="10">
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{Localize ToolKit/CrashReportDialog/Application, Default='Application'}"
                                                       Foreground="{DynamicResource TextFillColor2}"
                                                       VerticalAlignment="Center" FontSize="12" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{TemplateBinding ApplicationName}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{Localize ToolKit/CrashReportDialog/Version, Default='Version'}"
                                                       Foreground="{DynamicResource TextFillColor2}"
                                                       VerticalAlignment="Center" FontSize="12" />
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{TemplateBinding ApplicationVersion}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Text="{Localize ToolKit/CrashReportDialog/OccurredAt, Default='Occurred at'}"
                                                       Foreground="{DynamicResource TextFillColor2}"
                                                       VerticalAlignment="Center" FontSize="12" />
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Text="{TemplateBinding OccurredAt}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Exception summary (read-only) -->
                                        <Border Background="{DynamicResource BackgroundColor2}"
                                                BorderBrush="{DynamicResource ControlBorderColor}"
                                                BorderThickness="{DynamicResource ControlBorderThickness}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="10 8">
                                            <SelectableTextBlock Text="{TemplateBinding ExceptionMessage}"
                                                                 FontSize="12"
                                                                 TextWrapping="Wrap"
                                                                 Foreground="{DynamicResource SystemFillColorCritical}" />
                                        </Border>

                                        <!-- User message -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Localize ToolKit/CrashReportDialog/WhatWereYouDoingText, Default='What were you doing when the crash occurred? (optional)'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColor2}" />
                                            <TextBox Name="PART_UserMessageBox"
                                                     CornerRadius="{DynamicResource ControlCornerRadius}"
                                                     Height="72"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Stretch"
                                                     TextWrapping="Wrap"
                                                     PlaceholderText="{Localize ToolKit/CrashReportDialog/UserMessagePlaceholder, Default='Describe what you were doing…'}"
                                                     FontSize="12" />
                                        </StackPanel>

                                        <!-- Email -->
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <TextBlock Text="{Localize ToolKit/CrashReportDialog/YourEmailAddress, Default='Your email address'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColor2}" />
                                                <TextBlock Name="PART_EmailRequiredBadge"
                                                           Text="*"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SystemFillColorCritical}"
                                                           IsVisible="False" />
                                            </StackPanel>
                                            <TextBox Name="PART_EmailBox"
                                                     PlaceholderText="you@example.com"
                                                     FontSize="12" />
                                            <TextBlock Name="PART_EmailError"
                                                       Text="{Localize ToolKit/CrashReportDialog/EmailValidationError, Default='Please enter a valid email address.'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemFillColorCritical}"
                                                       IsVisible="False" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Exception tab -->
                                <ScrollViewer Name="PART_ExceptionTab"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="20 16"
                                              IsVisible="False">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{Localize ToolKit/CrashReportDialog/Type, Default='Type'}"
                                                       Foreground="{DynamicResource TextFillColor2}"
                                                       VerticalAlignment="Center" FontSize="12" />
                                            <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                                                 Text="{TemplateBinding ExceptionType}"
                                                                 FontSize="12"
                                                                 FontFamily="Consolas,Menlo,Monaco,monospace"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{Localize ToolKit/CrashReportDialog/Source, Default='Source'}"
                                                       Foreground="{DynamicResource TextFillColor2}"
                                                       VerticalAlignment="Center" FontSize="12" />
                                            <SelectableTextBlock Grid.Row="1" Grid.Column="1"
                                                                 Text="{TemplateBinding ExceptionSource}"
                                                                 FontSize="12"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Localize ToolKit/CrashReportDialog/Message, Default='Message'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColor2}" />
                                            <Border Background="{DynamicResource BackgroundColor3}"
                                                    BorderBrush="{DynamicResource ControlBorderColor}"
                                                    BorderThickness="{DynamicResource ControlBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="10 8">
                                                <SelectableTextBlock Text="{TemplateBinding ExceptionMessage}"
                                                                     FontSize="12"
                                                                     TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Localize ToolKit/CrashReportDialog/StackTrace, Default='Stack trace'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColor2}" />
                                            <Border Background="{DynamicResource BackgroundColor3}"
                                                    BorderBrush="{DynamicResource ControlBorderColor}"
                                                    BorderThickness="{DynamicResource ControlBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="10 8"
                                                    MaxHeight="160">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <SelectableTextBlock Text="{TemplateBinding StackTrace}"
                                                                         FontSize="11"
                                                                         FontFamily="Consolas,Menlo,Monaco,monospace"
                                                                         TextWrapping="NoWrap" />
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Screenshot tab -->
                                <Grid Name="PART_ScreenshotTab"
                                      RowDefinitions="Auto,*"
                                      Margin="20 16"
                                      IsVisible="False">
                                    <CheckBox Name="PART_ScreenshotToggle"
                                              Grid.Row="0"
                                              Content="{Localize ToolKit/CrashReportDialog/IncludeScreenshotInReport, Default='Include screenshot in report'}"
                                              IsChecked="{TemplateBinding IncludeScreenshot, Mode=TwoWay}"
                                              Margin="0 0 0 12" />
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource BackgroundColor3}"
                                            BorderBrush="{DynamicResource ControlBorderColor}"
                                            BorderThickness="{DynamicResource ControlBorderThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            ClipToBounds="True">
                                        <Image Source="{TemplateBinding Screenshot}"
                                               Stretch="Uniform"
                                               MaxHeight="220" />
                                    </Border>
                                </Grid>
                            </Panel>
                        </DockPanel>
                    </Border>
                </ShadowBorder>
            </ControlTemplate>
        </Setter>

        <!-- ── Tab switching via ListBox selection ────────────────────── -->
        <Style Selector="^:tab-general /template/ ScrollViewer#PART_GeneralTab">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:tab-exception /template/ ScrollViewer#PART_ExceptionTab">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:tab-screenshot /template/ Grid#PART_ScreenshotTab">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- ── Sending state ─────────────────────────────────────────── -->
        <Style Selector="^:sending /template/ Border#PART_StatusRow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:sending /template/ ProgressBar#PART_SendingProgress">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- ── Success state ─────────────────────────────────────────── -->
        <Style Selector="^:success /template/ Border#PART_StatusRow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:success /template/ PathIcon#PART_SuccessIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- ── Failure state ─────────────────────────────────────────── -->
        <Style Selector="^:failure /template/ Border#PART_StatusRow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:failure /template/ PathIcon#PART_FailureIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- ── Email validation ───────────────────────────────────────── -->
        <Style Selector="^:emailRequired /template/ TextBlock#PART_EmailRequiredBadge">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:emailInvalid /template/ TextBlock#PART_EmailError">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:emailInvalid /template/ TextBox#PART_EmailBox">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCritical}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>