<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Padding="20" Width="500">
            <StackPanel Spacing="8">
                <CommandBar>
                    <CommandBarButton Label="New">
                        <CommandBarButton.Icon>
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                        </CommandBarButton.Icon>
                    </CommandBarButton>
                    <CommandBarButton Label="Save">
                        <CommandBarButton.Icon>
                            <PathIcon
                                Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" />
                        </CommandBarButton.Icon>
                    </CommandBarButton>
                    <CommandBarToggleButton Label="Pin" Icon="{StaticResource PinRegular}" />
                </CommandBar>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- CommandBarButton ControlTheme -->
    <ControlTheme x:Key="{x:Type CommandBarButton}" TargetType="CommandBarButton">
        <Setter Property="Background" Value="{ColorToTransparent ControlFillColor2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Width" Value="68" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <RippleEffect Name="PART_Ripple"
                              Padding="{TemplateBinding Padding}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                    <StackPanel x:Name="PART_LayoutRoot"
                                Spacing="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <PleasantIcon Icon="{TemplateBinding Icon}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Name="PART_Label"
                                   Text="{TemplateBinding Label}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </RippleEffect>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ RippleEffect#PART_Ripple">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions> 
            </Setter> 
        </Style>
        <Style Selector="^ /template/ RippleEffect#PART_Ripple">
            <Setter Property="RippleFill" Value="{DynamicResource ControlFillColor3}" />
        </Style>

        <!-- Hover -->
        <Style Selector="^:pointerover /template/ RippleEffect#PART_Ripple">
            <Setter Property="Background" Value="{DynamicResource ControlFillColor2}" />
        </Style>

        <!-- Compact: hide label, reduce width -->
        <Style Selector="^[IsCompact=True]">
            <Setter Property="Width" Value="40" />
        </Style>
        <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- LabelPosition=Right: horizontal layout, auto-width -->
        <Style Selector="^[LabelPosition=Right]">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinWidth" Value="40" />
        </Style>
        <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style Selector="^[LabelPosition=Right] /template/ PleasantIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0 0 10 0" />
        </Style>
        <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- IsInOverflow: full-width horizontal layout -->
        <Style Selector="^[IsInOverflow=True]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="0" />
        </Style>
        <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="4,0,10,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ControlTheme>

    <!-- CommandBarToggleButton ControlTheme -->
    <ControlTheme x:Key="{x:Type CommandBarToggleButton}" TargetType="CommandBarToggleButton">
        <Setter Property="Background" Value="{ColorToTransparent ControlFillColor2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Width" Value="68" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <RippleEffect Name="PART_Ripple"
                              Padding="{TemplateBinding Padding}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                    <StackPanel x:Name="PART_LayoutRoot"
                                Spacing="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <PleasantIcon x:Name="PART_IconPresenter"
                                      Icon="{TemplateBinding Icon}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Name="PART_Label"
                                   Text="{TemplateBinding Label}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </RippleEffect>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ RippleEffect#PART_Ripple">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions> 
            </Setter> 
        </Style>
        <Style Selector="^ /template/ RippleEffect#PART_Ripple">
            <Setter Property="RippleFill" Value="{DynamicResource ControlFillColor3}" />
        </Style>

        <!-- Hover -->
        <Style Selector="^:pointerover /template/ RippleEffect#PART_Ripple">
            <Setter Property="Background" Value="{DynamicResource ControlFillColor2}" />
        </Style>

        <!-- Checked -->
        <Style Selector="^:checked /template/ RippleEffect#PART_Ripple">
            <Setter Property="Background" Value="{DynamicResource AccentLinearGradientBrush}" />
        </Style>
        
        <Style Selector="^:checked /template/ RippleEffect#PART_Ripple">
            <Setter Property="RippleFill" Value="Black" />
            <Setter Property="RippleOpacity" Value="0.2" />
        </Style>
        
        <Style Selector="^:checked:pointerover /template/ RippleEffect#PART_Ripple">
            <Setter Property="Background" Value="{DynamicResource AccentLightColor3}" />
        </Style>
        <Style Selector="^:checked:pressed /template/ RippleEffect#PART_Ripple">
            <Setter Property="Background" Value="{DynamicResource AccentLightColor3}" />
        </Style>

        <!-- Compact: hide label, reduce width -->
        <Style Selector="^[IsCompact=True]">
            <Setter Property="Width" Value="40" />
        </Style>
        <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- LabelPosition=Right: horizontal layout, auto-width -->
        <Style Selector="^[LabelPosition=Right]">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinWidth" Value="40" />
        </Style>
        <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style Selector="^[LabelPosition=Right] /template/ PleasantIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0 0 10 0" />
        </Style>
        <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- IsInOverflow: full-width horizontal layout -->
        <Style Selector="^[IsInOverflow=True]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="0" />
        </Style>
        <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="4,0,10,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ControlTheme>

    <!-- CommandBarSeparator ControlTheme -->
    <ControlTheme x:Key="{x:Type CommandBarSeparator}" TargetType="CommandBarSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource ControlBorderColor}"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        MinHeight="{TemplateBinding MinHeight}" />
            </ControlTemplate>
        </Setter>

        <!-- IsInOverflow: horizontal separator -->
        <Style Selector="^[IsInOverflow=True]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="4,4" />
        </Style>
    </ControlTheme>

    <!-- CommandBar ControlTheme -->
    <ControlTheme x:Key="{x:Type CommandBar}" TargetType="CommandBar">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource BackgroundColor1}" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="ItemWidthBottom" Value="70" />
        <Setter Property="ItemWidthRight" Value="102" />
        <Setter Property="ItemWidthCollapsed" Value="42" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        MinHeight="{TemplateBinding MinHeight}">
                    <Panel>
                        <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                            <!-- Overflow button (docked right) -->
                            <Button x:Name="PART_OverflowButton"
                                    Theme="{StaticResource AppBarButtonTheme}"
                                    Margin="2 0 0 0"
                                    DockPanel.Dock="Right"
                                    Padding="12,0"
                                    MinWidth="40"
                                    VerticalAlignment="Stretch"
                                    IsVisible="{TemplateBinding IsOverflowButtonVisible}">
                                <PleasantIcon Width="16" Height="16"
                                              Foreground="{TemplateBinding Foreground}"
                                              Icon="{StaticResource MoreRegular}" />
                            </Button>

                            <!-- Custom content area (docked left) -->
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              DockPanel.Dock="Left"
                                              VerticalAlignment="Center" />

                            <!-- Primary commands (fills remaining space, right-aligned) -->
                            <ItemsControl x:Name="PART_PrimaryCommands"
                                          ItemsSource="{Binding VisiblePrimaryCommands, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Stretch"
                                          ClipToBounds="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Overflow popup -->
                        <Popup x:Name="PART_OverflowPopup"
                               IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding #PART_OverflowButton}"
                               Placement="Bottom"
                               IsLightDismissEnabled="True"
                               WindowManagerAddShadowHint="False">
                            <ShadowBorder CornerRadius="{DynamicResource ControlCornerRadius}"
                                          Margin="6 4 6 6"
                                          BlurRadius="5"
                                          Offset="0 1"
                                          ShadowColor="#3C000000">
                                <Border Background="{DynamicResource BackgroundColor1}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="4"
                                        MinWidth="160">
                                    <ItemsControl x:Name="PART_OverflowPresenter"
                                                  ItemsSource="{Binding OverflowItems, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </ShadowBorder>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>