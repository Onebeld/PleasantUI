<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Padding="20" MinHeight="300" Width="700">
            <StackPanel Spacing="5">
                <OptionsDisplayItem Header="Header"
                                    Navigates="True">
                    <OptionsDisplayItem.ActionButton>
                        <ComboBox />
                    </OptionsDisplayItem.ActionButton>
                </OptionsDisplayItem>

                <OptionsDisplayItem Header="Header"
                                    Description="This is a description of whatver this does"
                                    Icon="{StaticResource CheckmarkRegular}"
                                    Content="Hello World">
                    <OptionsDisplayItem.ActionButton>
                        <ComboBox />
                    </OptionsDisplayItem.ActionButton>
                </OptionsDisplayItem>

                <OptionsDisplayItem Header="Header" Classes="Vertical"
                                    Description="This is a description of whatver this does"
                                    Expands="True"
                                    Content="Hello World" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type OptionsDisplayItem}" TargetType="OptionsDisplayItem">
        <Setter Property="Background" Value="{DynamicResource ControlFillColor1}" />
        <Setter Property="Padding" Value="11 0 11 0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="(IconHelper.Width)" Value="20" />
        <Setter Property="(IconHelper.Height)" Value="20" />
        <Setter Property="(IconHelper.IconSize)" Value="22" />

        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <RippleEffect x:Name="PART_Ripple"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  MinHeight="69"
                                  Padding="12 5"
                                  TemplatedControl.IsTemplateFocusTarget="True">
                        <DockPanel>
                            <PleasantIcon Name="IconHost"
                                          DockPanel.Dock="Left"
                                          Width="{TemplateBinding (IconHelper.Width)}"
                                          Height="{TemplateBinding (IconHelper.Height)}"
                                          FontSize="{TemplateBinding (IconHelper.FontSize)}"
                                          IconHelper.IconSize="{TemplateBinding (IconHelper.IconSize)}"
                                          Margin="8 4 14 4"
                                          Icon="{TemplateBinding Icon}" />
                            
                            <PathIcon Name="Chevron"
                                      DockPanel.Dock="Right"
                                      Width="12"
                                      Height="12"
                                      Margin="11 0 8 0" />

                            <ContentPresenter DockPanel.Dock="Right"
                                              Content="{TemplateBinding ActionButton}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Margin="4 4" />

                            <StackPanel VerticalAlignment="Center"
                                        Margin="6 0 0 0">
                                <TextBlock Theme="{StaticResource BaseTextBlockTheme}"
                                           Text="{TemplateBinding Header}" />
                                <TextBlock Theme="{StaticResource CaptionTextBlockTheme}"
                                           Text="{TemplateBinding Description}"
                                           Foreground="{DynamicResource TextFillColor2}"
                                           IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DockPanel>
                    </RippleEffect>

                    <ContentPresenter Name="ExpandedContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Opacity="0"
                                      VerticalContentAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource ControlFillColor1}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      Margin="0 2 0 0"
                                      ZIndex="-1"
                                      Padding="12" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ PleasantIcon#IconHost">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ PathIcon#Chevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#ExpandedContentPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^ /template/ RippleEffect#PART_Ripple">
            <Setter Property="RippleFill" Value="{DynamicResource ControlFillColor3}" />
        </Style>

        <Style Selector="^ /template/ RippleEffect#PART_Ripple">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ /template/ RippleEffect#PART_Ripple:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColor2}" />
        </Style>

        <Style Selector="^:icon /template/ PleasantIcon#IconHost">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:navigates /template/ PathIcon#Chevron">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Data" Value="{StaticResource ChevronRightRegular}" />
        </Style>

        <Style Selector="^:not(:expands)">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style Selector="^:expands /template/ PathIcon#Chevron">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Data" Value="{StaticResource ChevronDownRegular}" />
        </Style>

        <Style Selector="^:expanded /template/ PathIcon#Chevron">
            <Style.Animations>
                <Animation FillMode="Both" Duration="0:0:0.2" Easing="0,0 0,1">
                    <KeyFrame Cue="0">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="180" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:not(:expanded) /template/ PathIcon#Chevron">
            <Style.Animations>
                <Animation FillMode="Both" Duration="0:0:0.2" Easing="0,0 0,1">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="180" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:expanded /template/ ContentPresenter#ExpandedContentPresenter">
            <Style.Animations>
                <Animation Duration="0:0:0.2" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="-50" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>

            <Setter Property="IsVisible" Value="True" />
            <Setter Property="CornerRadius"
                    Value="{CompiledBinding $parent[OptionsDisplayItem].CornerRadius, Converter={x:Static CornerRadiusFilterConverters.Bottom}}" />
        </Style>
        <Style Selector="^:expanded /template/ RippleEffect#PART_Ripple">
            <Setter Property="CornerRadius"
                    Value="{CompiledBinding $parent[OptionsDisplayItem].CornerRadius, Converter={x:Static CornerRadiusFilterConverters.Top}}" />
        </Style>

        <Style Selector="^:not(:expands):expanded /template/ ContentPresenter#ExpandedContentPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:icon /template/ PleasantIcon#IconHost">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>