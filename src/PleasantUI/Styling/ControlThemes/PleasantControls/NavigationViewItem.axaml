<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
    <Design.PreviewWith>
        <NavigationView Width="300"
                        Height="400"
                        DisplayMode="CompactOverlay"
                        IsFloatingHeader="True">
            <NavigationViewItem Header="Header"
                                DockPanel.Dock="Top"
                                Title="Item Title"
                                Content="Item Content">
                <NavigationViewItem Header="Sub Item" IsExpanded="True" Title="SubItem Title" Content="SubItem Content">
                    <NavigationViewItem Header="SubItem 2" Title="SubItem 2 Title" Content="SubItem 2 Content" />
                    <NavigationViewItem Header="SubItem 3" Title="SubItem 3 Title" Content="SubItem 3 Content" />
                </NavigationViewItem>
            </NavigationViewItem>

            <Separator DockPanel.Dock="Top" />

            <NavigationViewItem Header="Header" DockPanel.Dock="Top" Title="Item Title"
                                Content="Item Content">
                <NavigationViewItem Header="Sub Item" Title="SubItem Title" Content="SubItem Content">
                    <NavigationViewItem Header="SubItem 2" Title="SubItem 2 Title" Content="SubItem 2 Content" />
                    <NavigationViewItem Header="SubItem 3" Title="SubItem 3 Title" Content="SubItem 3 Content" />
                </NavigationViewItem>
                <NavigationViewItem Header="Header" Title="Item Title"
                                    Content="Item Content">
                    <NavigationViewItem Header="Sub Item" IsExpanded="True" Title="SubItem Title"
                                        Content="SubItem Content">
                        <NavigationViewItem Header="SubItem 2" Title="SubItem 2 Title" Content="SubItem 2 Content" />
                        <NavigationViewItem Header="SubItem 3" Title="SubItem 3 Title" Content="SubItem 3 Content" />
                    </NavigationViewItem>
                </NavigationViewItem>
            </NavigationViewItem>
        </NavigationView>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type NavigationViewItem}" TargetType="NavigationViewItem">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="DockPanel.Dock" Value="Top" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{ColorToTransparent ControlFillColor2}" />
        <Setter Property="IsOpen" Value="{CompiledBinding $parent[NavigationView].IsOpen, Mode=OneWay}" />
        <Setter Property="CompactPaneLength" Value="{CompiledBinding $parent[NavigationView].CompactPaneLength, Mode=OneWay}" />
        <Setter Property="OpenPaneLength" Value="{CompiledBinding $parent[NavigationView].OpenPaneLength, Mode=OneWay}" />
        <Setter Property="(CompositionAnimationBehavior.UseImplicitAnimations)" Value="True" />
        <Setter Property="(IconHelper.IconSize)" Value="18" />
        <Setter Property="(IconHelper.Width)" Value="16" />
        <Setter Property="(IconHelper.Height)" Value="16" />
        
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Margin="5 0">
                    <RippleEffect x:Name="PART_Ripple"
                                  Padding="2.5"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Background="{TemplateBinding Background}"
                                  DockPanel.Dock="Top"
                                  TemplatedControl.IsTemplateFocusTarget="True">
                        <DockPanel>
                            <Panel Height="30" Width="35" DockPanel.Dock="Left">
                                <Border Name="PART_SelectionBorder"
                                        Width="3"
                                        Margin="-4 8 0 8"
                                        HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Background="{DynamicResource AccentLightColor2}" />

                                <PleasantIcon Name="PART_PathIcon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="{TemplateBinding (IconHelper.Width)}"
                                              Height="{TemplateBinding (IconHelper.Height)}"
                                              IconHelper.IconSize="{TemplateBinding (IconHelper.IconSize)}"
                                              Foreground="{DynamicResource TextFillColor1}"
                                              Icon="{TemplateBinding Icon}" />
                            </Panel>
                            <DockPanel Name="PART_ContainerDockPanel" Margin="5 0">
                                <ToggleButton Padding="5" Margin="5"
                                              BorderThickness="0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                              DockPanel.Dock="Right"
                                              Focusable="False"
                                              Background="#00000000">
                                    <PleasantIcon Name="PART_PathChevronDown"
                                                  IconHelper.Width="NaN"
                                                  IconHelper.Height="NaN"
                                                  Width="10"
                                                  Height="10"
                                                  Icon="{StaticResource ChevronDownRegular}" />
                                </ToggleButton>
                                
                                <Border Name="PART_ContainerBorder">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.4"
                                                              Easing="ExponentialEaseOut" />
                                        </Transitions>
                                    </Border.Transitions>
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      TextElement.FontSize="14" />
                                </Border>
                            </DockPanel>
                        </DockPanel>
                    </RippleEffect>
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    Margin="0 2 0 0"
                                    IsVisible="{TemplateBinding IsExpanded}"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ RippleEffect#PART_Ripple">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^ /template/ DockPanel#PART_ContainerDockPanel">
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="^[IsOpen=True] /template/ DockPanel#PART_ContainerDockPanel">
            <Style.Animations>
                <Animation Duration="00:00:0.02" Easing="ExponentialEaseOut"> <!--Easing="0.1,0.9,0.2,1.0"> -->
                    <KeyFrame Cue="0%">
                        <Setter Property="Width" Value="0" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Width" Value="{CompiledBinding $parent[NavigationViewItem].ExternalLength}" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^[IsOpen=False] /template/ RippleEffect#PART_Ripple">
            <Setter Property="ToolTip.Tip" Value="{CompiledBinding $parent[NavigationViewItem].Header}" />
        </Style>
        
        <Style Selector="^[IsExpanded=False] /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="(KeyboardNavigation.TabNavigation)" Value="Continue" />
        </Style>

        <Style Selector="^[IsExpanded=true] /template/ ItemsPresenter#PART_ItemsPresenter">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="-100" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^ /template/ Border#PART_SelectionBorder">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:.075" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <Style Selector="^:selected /template/ Border#PART_SelectionBorder">
            <Setter Property="RenderTransform" Value="scaleY(1)" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_SelectionBorder">
            <Setter Property="RenderTransform" Value="scaleY(1.2)" />
        </Style>
        <Style Selector="^:selected:pressed /template/ Border#PART_SelectionBorder">
            <Setter Property="RenderTransform" Value="scaleY(0.8)" />
        </Style>
        <Style Selector="^:not(:selected) /template/ Border#PART_SelectionBorder">
            <Setter Property="RenderTransform" Value="scaleY(0)" />
        </Style>

        <Style Selector="^:selected /template/ RippleEffect#PART_Ripple">
            <Setter Property="RippleFill" Value="{DynamicResource ControlFillColor3}" />
        </Style>
        <Style Selector="^:selected /template/ RippleEffect#PART_Ripple">
            <Setter Property="Background" Value="{DynamicResource ControlFillColor2}" />
        </Style>
        <Style Selector="^:empty /template/ ToggleButton">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^ /template/ ToggleButton">
            <Style Selector="^[IsChecked=True] /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Style>

        <Style Selector="^[IsExpanded=False] /template/ PleasantIcon#PART_PathChevronDown">
            <Style.Animations>
                <Animation Duration="0:0:0.5" Easing="ExponentialEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="190" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^[IsExpanded=True] /template/ PleasantIcon#PART_PathChevronDown">
            <Style.Animations>
                <Animation Duration="0:0:0.5" Easing="ExponentialEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="180" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^[IsOpen=true] /template/ Border#PART_ContainerBorder">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^[IsOpen=False] /template/ Border#PART_ContainerBorder">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^ /template/ RippleEffect#PART_Ripple">
            <Setter Property="RippleFill" Value="{DynamicResource ControlFillColor3}" />
        </Style>

        <Style Selector="^ /template/ RippleEffect:pointerover#PART_Ripple">
            <Setter Property="Background" Value="{DynamicResource ControlFillColor2}" />
        </Style>

        <Style Selector="^.header /template/ RippleEffect:pointerover#PART_Ripple">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:.075" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLightColor2}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter > TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="^ /template/ PleasantIcon#PART_PathIcon">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:.075" />
                    <BrushTransition Property="Foreground" Duration="0:0:.075" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="^:pointerover /template/ PleasantIcon#PART_PathIcon">
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>
        <Style Selector="^:pressed /template/ PleasantIcon#PART_PathIcon">
            <Setter Property="RenderTransform" Value="scale(0.9)" />
        </Style>
        <Style Selector="^:selected /template/ PleasantIcon#PART_PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentLinearGradientBrush}" />
        </Style>

        <!-- Show popup submenu indicator chevron (right-pointing) when in compact mode with children -->
        <Style Selector="^[IsOpen=False]:not(:empty) /template/ PleasantIcon#PART_PathChevronDown">
            <Setter Property="Icon" Value="{StaticResource ChevronRightRegular}" />
        </Style>
        <!-- Highlight item when its popup submenu is open in compact mode -->
        <Style Selector="^[IsSubMenuOpen=True][IsOpen=False] /template/ RippleEffect#PART_Ripple">
            <Setter Property="Background" Value="{DynamicResource ControlFillColor2}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>