<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Padding="0 50">
            <PleasantTitleBar />
        </Border>
    </Design.PreviewWith>

    <PleasantMenuFlyout x:Key="WindowMenuFlyout">
        <MenuItem x:Name="PART_ReestablishMenuItem"
                  Header="{Localize Restore, Default='_Restore'}"
                  Icon="{DynamicResource SquareMultipleRegular}"
                  IconHelper.FontSize="2"
                  IconHelper.Width="12"
                  IconHelper.Height="12" />
        <MenuItem Name="PART_CollapseMenuItem"
                  Header="{Localize CollapseMenu, Default='C_ollapse'}" Icon="{DynamicResource SubtractRegular}"
                  IconHelper.Width="12"
                  IconHelper.Height="12" />
        <MenuItem Name="PART_ExpandMenuItem"
                  Header="{Localize ExpandMenu, Default='_Expand'}" Icon="{DynamicResource MaximizeRegular}"
                  IconHelper.Width="12"
                  IconHelper.Height="12" />

        <Separator Background="{DynamicResource ControlBorderColor}"
                   Height="1"
                   Margin="-4 1 -4 1" />

        <MenuItem Name="PART_CloseMenuItem"
                  Header="{Localize CloseMenu, Default='_Close'}"
                  InputGesture="Ctrl+Q" Icon="{DynamicResource DismissRegular}" 
                  IconHelper.Width="12"
                  IconHelper.Height="12" />
    </PleasantMenuFlyout>

    <ControlTheme x:Key="{x:Type PleasantTitleBar}" TargetType="PleasantTitleBar">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
            <ControlTemplate>
                    <Grid x:Name="PART_TitleBarGrid">
                    <Border x:Name="PART_DragWindow"
                            Background="Transparent"
                            ContextFlyout="{DynamicResource WindowMenuFlyout}"
                            WindowDecorationProperties.ElementRole="TitleBar" />

                    <ContentPresenter x:Name="PART_LeftTitleBarContent" />

                    <StackPanel x:Name="PART_TitlePanel"
                                Orientation="Horizontal"
                                Margin="5 0 0 0"
                                Spacing="5"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <IconControl x:Name="PART_DisplayIcon" Width="16" Height="16" Margin="10 0 5 0" />
                        
                        <IconControl x:Name="PART_DisplayTitle" MaxWidth="75" />
                        
                        <TextBlock x:Name="PART_Subtitle"
                                   FontSize="12"
                                   Margin="3 0 0 0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColor3}" />
                    </StackPanel>

                    <ContentPresenter x:Name="PART_TitleBarContent" />

                    <OnPlatform>
                        <OnPlatform.Default>
                            <PleasantCaptionButtons x:Name="PART_PleasantCaptionButtons" />
                        </OnPlatform.Default>
                        <OnPlatform.macOS>
                            <PleasantCaptionButtons x:Name="PART_PleasantCaptionButtons"
                                                    Theme="{DynamicResource PleasantCaptionButtonsMacOSStyle}" />
                        </OnPlatform.macOS>
                    </OnPlatform>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:isactive /template/ IconControl#PART_DisplayTitle">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="^:isactive /template/ IconControl#PART_DisplayIcon">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </ControlTheme>
</ResourceDictionary>