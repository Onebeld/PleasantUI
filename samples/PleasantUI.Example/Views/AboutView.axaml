<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="PleasantUI.Example.Views.AboutView">
    <ScrollViewer>
        <StackPanel Margin="25" Spacing="16" CompositionAnimationBehavior.UseImplicitChildrenAnimations="True">
            <!-- Header -->
            <TextBlock Text="{Localize {x:Static LocKey.AboutTitle}}"
                       Margin="0 0 0 10"
                       Theme="{StaticResource TitleTextBlockTheme}" />

            <!-- Hero Section with Logo and Version -->
            <PleasantBorder BackgroundLevel="Level3"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Logo -->
                    <PleasantIcon Icon="{StaticResource PleasantUILogo}" Width="80" Height="80" />

                    <!-- Title and Version -->
                    <StackPanel Grid.Column="1" Margin="20 0" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource PleasantUINoLogo}"
                                  Height="35"
                                  Width="NaN"
                                  HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 8 0 0">
                            <TextBlock Foreground="{DynamicResource TextFillColor3}"
                                       FontSize="13"
                                       Text="{Localize {x:Static LocKey.About__License}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Author -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <PathIcon Data="{StaticResource Onebeld}"
                                  Width="120"
                                  Height="NaN"
                                  HorizontalAlignment="Right" />
                        <TextBlock Text="Dmitry Zhutkov"
                                   FontSize="12"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource TextFillColor3}"
                                   Margin="0 5 0 0" />
                    </StackPanel>
                </Grid>
            </PleasantBorder>

            <!-- Description Section with Rich Formatting -->
            <PleasantBorder BackgroundLevel="Level3"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PleasantIcon Icon="{x:Static  icons:MaterialIconKind.InformationCircleOutline}"
                                     Width="16"
                                     Height="16" />
                        <TextBlock Text="{Localize Description}"
                                   FontWeight="SemiBold"
                                   FontSize="16" />
                    </StackPanel>

                    <!-- Multiline description in a styled read-only TextBox -->
                    <PleasantBorder BackgroundLevel="Level4"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12">
                        <TextBox Text="{Localize LibraryDescription}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontSize="14"
                                 LineHeight="22" />
                    </PleasantBorder>

                    <!-- Feature Highlights -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                        <Grid.Styles>
                            <Style Selector="PleasantIcon">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Margin" Value="0 0 10 0" />
                                <Setter Property="(IconHelper.IconSize)" Value="24" />
                                <Setter Property="(Grid.Column)" Value="0" />
                            </Style>
                            <Style Selector="TextBlock.Title">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                            <Style Selector="TextBlock.Description">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColor3}" />
                            </Style>
                        </Grid.Styles>
                        
                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0 8" Classes="featureItem">
                            <PleasantIcon Icon="{x:Static icons:MaterialIconKind.Blur}" />
                            
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="Title" Text="{Localize {x:Static LocKey.About__FeatureFluentDesign}}" />
                                <TextBlock Classes="Description" Text="{Localize {x:Static LocKey.About__FeatureFluentDesignDesc}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8 0 0 8">
                            <PleasantIcon Icon="{x:Static icons:MaterialIconKind.ViewDashboardEditOutline}" />
                            
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="Title" Text="{Localize {x:Static LocKey.About__FeatureCustomControls}}" />
                                <TextBlock Classes="Description" Text="{Localize {x:Static LocKey.About__FeatureCustomControlsDesc}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="0" Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0 8">
                            <PleasantIcon Icon="{x:Static icons:MaterialIconKind.BrushOutline}" />
                            
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="Title" Text="{Localize {x:Static LocKey.About__FeatureThemes}}" />
                                <TextBlock Classes="Description" Text="{Localize {x:Static LocKey.About__FeatureThemesDesc}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8 0 0 8">
                            <PleasantIcon Icon="{x:Static icons:MaterialIconKind.Translate}" />
                            
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="Title" Text="{Localize {x:Static LocKey.About__FeatureLocalization}}" />
                                <TextBlock Classes="Description" Text="{Localize {x:Static LocKey.About__FeatureLocalizationDesc}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="0" Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0 8">
                            <PleasantIcon Icon="{x:Static icons:MaterialIconKind.FastForward}" />
                            
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="Title" Text="{Localize About/FeatureAOT}" />
                                <TextBlock Classes="Description" Text="{Localize About/FeatureAOTDesc}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto,*" Margin="8 0 0 8">
                            <PleasantIcon Icon="{x:Static icons:MaterialIconKind.Laptop}" />
                            
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="Title" Text="{Localize About/FeatureCrossPlatform}" />
                                <TextBlock Classes="Description" Text="{Localize About/FeatureCrossPlatformDesc}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </PleasantBorder>

            <!-- Links Section -->
            <OptionsDisplayItem Header="{Localize Links}"
                                Icon="{x:Static icons:MaterialIconKind.Link}"
                                Expands="True"
                                IsExpanded="True">
                <OptionsDisplayItem.Content>
                    <StackPanel Spacing="10" Margin="45 0 0 0">
                        <Button x:Name="GitHubButton"
                                Theme="{StaticResource AppBarButtonTheme}"
                                HorizontalAlignment="Left"
                                Padding="12 6"
                                Click="GitHubButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PleasantIcon Icon="{StaticResource Github}" />
                                <TextBlock Text="{Localize About/GitHubRepo}"
                                           Foreground="{DynamicResource AccentLightColor1}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PatreonButton"
                                Theme="{StaticResource AppBarButtonTheme}"
                                HorizontalAlignment="Left"
                                Padding="12 6"
                                Click="PatreonButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PleasantIcon Icon="{StaticResource Patreon}" />
                                
                                <TextBlock Text="{Localize About/PatreonSupport}"
                                           Foreground="{DynamicResource AccentLightColor1}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BoostyButton"
                                Theme="{StaticResource AppBarButtonTheme}"
                                HorizontalAlignment="Left"
                                Padding="12 6"
                                Click="BoostyButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PleasantIcon Icon="{StaticResource Boosty}" IconHelper.Width="16" IconHelper.Height="16" />
                                
                                <TextBlock Text="{Localize About/BoostySupport}"
                                           Foreground="{DynamicResource AccentLightColor1}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </OptionsDisplayItem.Content>
            </OptionsDisplayItem>

            <!-- Credits Section -->
            <PleasantBorder BackgroundLevel="Level3"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PleasantIcon Icon="{x:Static icons:MaterialIconKind.Heart}"
                                     Foreground="{DynamicResource TextFillColor1}"
                                     Width="16"
                                     Height="16" />
                        
                        <TextBlock Text="{Localize About/CreditsTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                    </StackPanel>
                    <TextBox Text="{Localize About/CreditsText}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             FontSize="13"
                             LineHeight="20"
                             Foreground="{DynamicResource TextFillColor3}" />
                </StackPanel>
            </PleasantBorder>
        </StackPanel>
    </ScrollViewer>
</UserControl>
